{
  "name": "@pathscale/test-ui",
  "version": "0.1.0",
  "description": "Small Layout UI used to inspect the solid-layouts library compiler output",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./layouts": "./layouts.manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "**/*"
  ],
  "peerDependencies": {
    "solid-js": "^1.9.14",
    "solid-layouts": "^0.1.0"
  },
  "dependencies": {
    "tailwind-merge": "^3.3.1"
  },
  "solidLayouts": "./layouts.manifest.json"
}
