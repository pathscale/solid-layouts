{
  "name": "solid-layouts",
  "version": "0.2.0",
  "description": "Logic in a .ts file, markup in a .layout.tsx file, presentation declared at the call site",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipe": {
      "types": "./dist/recipe.d.ts",
      "import": "./dist/recipe.js"
    },
    "./cx": {
      "types": "./dist/cx.d.ts",
      "import": "./dist/cx.js"
    },
    "./application-boundary": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid-2": {
      "types": "./dist/solid-2/index.d.ts",
      "import": "./dist/solid-2/index.js"
    },
    "./solid-2/recipe": {
      "types": "./dist/solid-2/recipe.d.ts",
      "import": "./dist/solid-2/recipe.js"
    },
    "./solid-2/cx": {
      "types": "./dist/solid-2/cx.d.ts",
      "import": "./dist/solid-2/cx.js"
    },
    "./solid-2/application-boundary": {
      "types": "./dist/solid-2/index.d.ts",
      "import": "./dist/solid-2/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "bun run build",
    "test": "bun test --conditions=browser",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "solid-js": "^1.9.14 || ^2.0.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.0",
    "@types/bun": "^1.3.14",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathscale/solid-layouts.git",
    "directory": "packages/solid-layouts"
  },
  "publishConfig": {
    "access": "public"
  }
}
