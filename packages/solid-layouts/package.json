{
  "name": "solid-layouts",
  "version": "0.1.2",
  "description": "Logic in a .ts file, markup in a .layout.tsx file, presentation declared at the call site",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipe": {
      "types": "./dist/recipe.d.ts",
      "import": "./dist/recipe.js"
    },
    "./cx": {
      "types": "./dist/cx.d.ts",
      "import": "./dist/cx.js"
    },
    "./application-boundary": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/recipe.ts src/cx.ts --outdir dist --target browser --format esm --splitting --external solid-js --external 'solid-js/*' && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test --conditions=browser",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathscale/solid-layouts.git",
    "directory": "packages/solid-layouts"
  },
  "publishConfig": {
    "access": "public"
  }
}
