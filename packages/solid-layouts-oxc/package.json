{
  "name": "solid-layouts-oxc",
  "version": "0.1.5",
  "description": "The Layouts pre-pass for SolidJS, built on oxc",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./loader": {
      "default": "./loader.js"
    },
    "./library": {
      "types": "./library.d.ts",
      "default": "./library.js"
    },
    "./application": {
      "types": "./application.d.ts",
      "default": "./application.js"
    },
    "./porting": {
      "types": "./porting.d.ts",
      "default": "./porting.js"
    }
  },
  "bin": {
    "solid-layouts-library": "bin/solid-layouts-library.js",
    "solid-layouts-application": "bin/solid-layouts-application.js",
    "solid-layouts-lint": "bin/solid-layouts-lint.js"
  },
  "files": [
    "index.js",
    "*.d.ts",
    "loader.js",
    "library.js",
    "application.js",
    "porting.js",
    "bin",
    "*.node"
  ],
  "napi": {
    "binaryName": "solid-layouts-oxc",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --features napi",
    "build:debug": "napi build --platform --features napi",
    "test:library": "bun test library.test.js",
    "test:application": "bun test application.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathscale/solid-layouts.git",
    "directory": "packages/solid-layouts-oxc"
  }
}
